# Safe defaults. Copy to .env and replace placeholders locally.
DRY_RUN=true
ALLOWED_NUMBERS=+12125550123
CALLER_NAME=your assistant
MAX_PER_HOUR=5
MAX_MESSAGE_LENGTH=1000
# Optional: one exact number or starred prefix per line. Missing files deny actions.
BLOCKLIST_FILE=
AUDIT_FILE=data/audit.jsonl
STATE_FILE=data/state.sqlite3
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set a randomly generated token before exposing HTTP to bearer-capable clients.
MCP_HTTP_TOKEN=
# Exact public HTTPS resource, including /mcp, when tunneling.
MCP_PUBLIC_URL=
# For ChatGPT OAuth, leave MCP_HTTP_TOKEN empty and configure these together.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
# POLICY_FILE=policy.yaml
